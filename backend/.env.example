NODE_ENV=development
PORT=5001
# Use 0.0.0.0 when testing from the Android emulator or a phone on the LAN.
HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=hospital_resource_db
# PostgreSQL pool limits. Size this below the database's connection limit when
# multiple API instances are deployed.
DB_POOL_MAX=12
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
# Server-owned business day for daily hospital queue QR expiry.
HOSPITAL_TIMEZONE=Asia/Kolkata
# CareGuide medical answers use RAG context plus Ollama; PostgreSQL supplies
# hospital and doctor facts. Gemini is not used in the RAG answer path.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=45000
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_PREDICT=300
# Local multilingual embedding model used only by RAG. Install with:
# ollama pull nomic-embed-text:latest
RAG_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_CHUNK_SIZE=3000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_QUERY_TIMEOUT_MS=30000
RAG_EMBED_BATCH_SIZE=8
# OpenAI is retained for future explicit opt-in only. It is not used by
# CareGuide's normal request path.

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Required only when running `npm run init-db`.
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional SMS provider webhook. It receives { to, message }; without it, SOS
# notifications are recorded as pending and safely logged for development.
SMS_WEBHOOK_URL=
# Persistent SOS escalation configuration. Run `npm run worker:sos-dispatch`
# from a process scheduler at least every 10 seconds in production.
EMERGENCY_HOSPITAL_RESPONSE_TIMEOUT_SECONDS=30
EMERGENCY_SEARCH_RADIUS_KM=30
# Public HTTPS application origin used for expiring emergency-contact links.
PUBLIC_APP_URL=
