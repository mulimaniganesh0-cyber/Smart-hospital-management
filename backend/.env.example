NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=db1234
DB_NAME=hospital_resource_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
# CareGuide runs locally and free by default through Ollama.
CHATBOT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional paid OpenAI provider: set CHATBOT_PROVIDER=openai and add a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Required only when running `npm run init-db`.
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
